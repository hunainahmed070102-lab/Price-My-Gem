# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ─── MySQL / XAMPP ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pricemygem_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ─── AI Model ─────────────────────────────────────────────────────────────────
AI_MODEL_URL=http://localhost:8000/predict

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ─── Default Admin (used by seed script) ─────────────────────────────────────
ADMIN_EMAIL=pricemygem@gmail.com
ADMIN_PASSWORD=admin123
